{
	"name": "@ecopages/scripts-injector",
	"main": "dist/scripts-injector.js",
	"version": "0.1.3",
	"type": "module",
	"types": "types.d.ts",
	"repository": {
		"type": "git",
		"url": "https://github.com/ecopages/scripts-injector"
	},
	"exports": {
		"./package.json": {
			"import": "./package.json"
		},
		".": {
			"import": "./dist/scripts-injector.js",
			"require": "./dist/scripts-injector.js"
		},
		"./global": {
			"import": "./dist/global-injector.js",
			"require": "./dist/global-injector.js"
		},
		"./types": "./types.d.ts"
	},
	"scripts": {
		"build:lib": "rm -rf dist && bun build --entry scripts-injector.ts --entry global-injector.ts --outdir dist --minify",
		"prepack": "bun run build:lib",
		"test": "vitest",
		"test:run": "vitest run"
	},
	"devDependencies": {
		"@testing-library/dom": "^10.4.1",
		"@types/bun": "latest",
		"@vitest/browser-playwright": "^4.0.16",
		"vitest": "^4.0.16"
	},
	"peerDependencies": {
		"typescript": "^5.0.0"
	},
	"files": [
		"dist",
		"/types.d.ts"
	]
}
