{
	"name": "@ecopages/scripts-injector",
	"main": "dist/scripts-injector.js",
	"version": "0.1.5",
	"type": "module",
	"types": "types.d.ts",
	"repository": {
		"type": "git",
		"url": "https://github.com/ecopages/scripts-injector"
	},
	"exports": {
		"./package.json": {
			"import": "./package.json"
		},
		".": {
			"types": "./types.d.ts",
			"import": "./dist/scripts-injector.js",
			"require": "./dist/scripts-injector.js"
		},
		"./global": {
			"types": "./types.d.ts",
			"import": "./dist/global-injector.js",
			"require": "./dist/global-injector.js"
		},
		"./types": "./types.d.ts"
	},
	"scripts": {
		"build:lib": "node build.mjs",
		"prepack": "pnpm run build:lib",
		"test": "vitest",
		"test:run": "vitest run"
	},
	"devDependencies": {
		"@testing-library/dom": "^10.4.1",
		"@vitest/browser-playwright": "^4.0.16",
		"esbuild": "^0.27.0",
		"typescript": "^5.9.3",
		"vitest": "^4.0.16"
	},
	"files": [
		"dist",
		"/types.d.ts"
	]
}
