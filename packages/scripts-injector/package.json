{
	"name": "@ecopages/scripts-injector",
	"main": "scripts-injector.js",
	"version": "0.1.2",
	"type": "module",
	"types": "types.d.ts",
	"repository": {
		"type": "git",
		"url": "https://github.com/ecopages/scripts-injector"
	},
	"exports": {
		"./package.json": {
			"import": "./package.json"
		},
		".": {
			"import": "./scripts-injector.js",
			"require": "./scripts-injector.js"
		},
		"./types": "./types.d.ts"
	},
	"scripts": {
		"build:lib": "rm -rf dist && bun build --entry scripts-injector.ts --outdir . --minify",
		"test": "vitest",
		"test:run": "vitest run"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"@vitest/browser-playwright": "^4.0.16",
		"vitest": "^4.0.16"
	},
	"peerDependencies": {
		"typescript": "^5.0.0"
	},
	"files": [
		"scripts-injector.js",
		"/types.d.ts"
	]
}
