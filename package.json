{
	"name": "scripts-injector",
	"module": "index.ts",
	"type": "module",
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"clean": "rm -rf .eco node_modules bun.lockb && bun install && bun run build:all",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"build:all": "bun run --filter '*' build:lib",
		"changeset": "changeset",
		"version": "changeset version",
		"prerelease": "bun run build:all",
		"release": "changeset publish",
		"test:run": "bun run --filter '*' test:run",
		"dev:www": "bun run --filter 'www' dev",
		"prepare": "husky"
	},
	"peerDependencies": {
		"typescript": "^5.0.0"
	},
	"devDependencies": {
		"@changesets/changelog-github": "^0.5.0",
		"@changesets/cli": "^2.27.5",
		"@playwright/test": "^1.58.1",
		"@types/bun": "latest",
		"husky": "^9.0.10",
		"lint-staged": "^15.2.2",
		"oxlint": "latest"
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx,mjs,cjs}": "oxlint --fix"
	},
	"workspaces": [
		"packages/*",
		"apps/*"
	]
}
